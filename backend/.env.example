# ===== Nationwide Paper IT Inventory - Backend =====
NODE_ENV=production
PORT=5000
APP_URL=https://inventory.nationwide-paper.com
API_URL=https://inventory.nationwide-paper.com/api

# PostgreSQL
DATABASE_URL=postgresql://inventory:CHANGE_ME_DB_PASSWORD@db:5432/it_inventory?schema=public

# JWT
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# Microsoft 365 (Azure AD app registration)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=https://inventory.nationwide-paper.com/api/auth/microsoft/callback

# SMTP (e.g. Microsoft 365 SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=it-inventory@nationwide-paper.com
SMTP_PASS=
MAIL_FROM="NP IT Inventory <it-inventory@nationwide-paper.com>"
IT_MANAGER_EMAIL=it-manager@nationwide-paper.com

# Microsoft Teams incoming webhook
TEAMS_WEBHOOK_URL=

# Alerts
WARRANTY_ALERT_DAYS=30
LICENSE_ALERT_DAYS=30
ALERT_CRON=0 8 * * *

# Uploads
MAX_UPLOAD_MB=10

# Firebase Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Vercel AI SDK Configuration
GEMINI_API_KEY=
