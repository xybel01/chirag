generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  IT_MANAGER
  IT_SUPPORT
  HR
  ACCOUNTS
  EMPLOYEE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  FAULTY
  LOST
  DISPOSED
}

enum AssignmentAction {
  ASSIGN
  RETURN
  TRANSFER
  REPLACE
  REPAIR
  DISPOSE
}

enum RepairStatus {
  OPEN
  SENT_TO_VENDOR
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockType {
  ACCESSORY
  CONSUMABLE
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  name               String
  passwordHash       String?
  role               Role                @default(EMPLOYEE)
  phone              String?
  jobTitle           String?
  departmentId       Int?
  department         Department?         @relation(fields: [departmentId], references: [id])
  isActive           Boolean             @default(true)
  msObjectId         String?             @unique
  resetToken         String?
  resetTokenExp      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assets             Asset[]             @relation("AssetAssignee")
  assignments        Assignment[]        @relation("AssignmentUser")
  performedActions   Assignment[]        @relation("AssignmentActor")
  repairTickets      RepairTicket[]
  licenseAssignments LicenseAssignment[]
  auditLogs          AuditLog[]
}

model Department {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  users  User[]
  assets Asset[]
}

model Location {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  address    String?
  assets     Asset[]
  stockItems StockItem[]
}

model Vendor {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  contactName   String?
  email         String?
  phone         String?
  address       String?
  assets        Asset[]
  repairTickets RepairTicket[]
  licenses      License[]
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  code   String  @unique // used in asset tag e.g. NP-LAP-0001
  assets Asset[]
}

model Asset {
  id            Int            @id @default(autoincrement())
  assetTag      String         @unique
  serialNumber  String         @unique
  model         String
  manufacturer  String
  categoryId    Int
  category      Category       @relation(fields: [categoryId], references: [id])
  vendorId      Int?
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  purchaseDate  DateTime?
  purchasePrice Decimal?       @db.Decimal(12, 2)
  invoiceFile   String?
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  warrantyFile  String?
  locationId    Int?
  location      Location?      @relation(fields: [locationId], references: [id])
  departmentId  Int?
  department    Department?    @relation(fields: [departmentId], references: [id])
  status        AssetStatus    @default(AVAILABLE)
  assignedToId  Int?
  assignedTo    User?          @relation("AssetAssignee", fields: [assignedToId], references: [id])
  notes         String?
  ram           String?
  storage       String?
  cpu           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignments   Assignment[]
  repairTickets RepairTicket[]

  @@index([status])
  @@index([categoryId])
  @@index([warrantyEnd])
}

model Assignment {
  id           Int              @id @default(autoincrement())
  assetId      Int
  asset        Asset            @relation(fields: [assetId], references: [id])
  userId       Int
  user         User             @relation("AssignmentUser", fields: [userId], references: [id])
  action       AssignmentAction
  performedById Int
  performedBy  User             @relation("AssignmentActor", fields: [performedById], references: [id])
  notes        String?
  signature    String? // base64 PNG of employee digital signature
  ackFile      String? // generated acknowledgement PDF path
  createdAt    DateTime         @default(now())
  returnedAt   DateTime?

  @@index([assetId])
  @@index([userId])
}

model RepairTicket {
  id              Int          @id @default(autoincrement())
  ticketNo        String       @unique
  assetId         Int
  asset           Asset        @relation(fields: [assetId], references: [id])
  reportedById    Int
  reportedBy      User         @relation(fields: [reportedById], references: [id])
  vendorId        Int?
  vendor          Vendor?      @relation(fields: [vendorId], references: [id])
  issue           String
  diagnosis       String?
  partsReplaced   String?
  isWarrantyClaim Boolean      @default(false)
  cost            Decimal      @default(0) @db.Decimal(12, 2)
  status          RepairStatus @default(OPEN)
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  updatedAt       DateTime     @updatedAt

  @@index([status])
}

model License {
  id           Int                 @id @default(autoincrement())
  name         String // e.g. Microsoft 365 Business Premium
  type         String // M365 | ANTIVIRUS | RINGCENTRAL | DYNAMICS365 | OTHER
  vendorId     Int?
  vendor       Vendor?             @relation(fields: [vendorId], references: [id])
  licenseKey   String?
  totalSeats   Int                 @default(1)
  purchaseDate DateTime?
  expiryDate   DateTime?
  costPerSeat  Decimal?            @db.Decimal(12, 2)
  totalCost    Decimal?            @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  assignments  LicenseAssignment[]

  @@index([expiryDate])
}

model LicenseAssignment {
  id         Int       @id @default(autoincrement())
  licenseId  Int
  license    License   @relation(fields: [licenseId], references: [id])
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([licenseId])
  @@index([userId])
}

model StockItem {
  id          Int       @id @default(autoincrement())
  name        String
  type        StockType
  quantity    Int       @default(0)
  minQuantity Int       @default(5)
  unitPrice   Decimal?  @db.Decimal(12, 2)
  locationId  Int?
  location    Location? @relation(fields: [locationId], references: [id])
  notes       String?
  updatedAt   DateTime  @updatedAt

  @@unique([name, locationId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE | UPDATE | DELETE | ASSIGN | RETURN | LOGIN | ...
  entity    String // Asset | User | Assignment | ...
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
