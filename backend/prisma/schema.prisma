generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  IT_MANAGER
  IT_SUPPORT
  DEPARTMENT_MANAGER
  HR
  ACCOUNTS
  APPROVER
  EMPLOYEE
  AUDITOR
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  FAULTY
  LOST
  DISPOSED
}

enum AssignmentAction {
  ASSIGN
  RETURN
  TRANSFER
  REPLACE
  REPAIR
  DISPOSE
}

enum RepairStatus {
  OPEN
  SENT_TO_VENDOR
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockType {
  ACCESSORY
  CONSUMABLE
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  PROBLEM
  CHANGE_REQUEST
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_USER
  PENDING_VENDOR
  PENDING_APPROVAL
  ON_HOLD
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum SLAStatus {
  WITHIN_SLA
  WARNING
  BREACHED
  PAUSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  name               String
  passwordHash       String?
  role               Role                @default(EMPLOYEE)
  phone              String?
  jobTitle           String?
  departmentId       Int?
  department         Department?         @relation(fields: [departmentId], references: [id])
  isActive           Boolean             @default(true)
  msObjectId         String?             @unique
  resetToken         String?
  resetTokenExp      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assets             Asset[]             @relation("AssetAssignee")
  assignments        Assignment[]        @relation("AssignmentUser")
  performedActions   Assignment[]        @relation("AssignmentActor")
  repairTickets      RepairTicket[]
  licenseAssignments LicenseAssignment[]
  auditLogs          AuditLog[]

  // ITSM Relations
  ticketRequisitions Ticket[]            @relation("TicketRequester")
  ticketAffections   Ticket[]            @relation("TicketAffectedUser")
  ticketAssignments  Ticket[]            @relation("TicketAssignee")
  ticketComments     TicketComment[]
  ticketWatchings    TicketWatcher[]
  workLogs           WorkLog[]
  approvalSteps      ApprovalStep[]
  kbArticles         KnowledgeArticle[]
  offboardingRequests OffboardingRequest[]
}

model Department {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  users  User[]
  assets Asset[]
}

model Location {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  address    String?
  assets     Asset[]
  stockItems StockItem[]
}

model Vendor {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  assets        Asset[]
  repairTickets RepairTicket[]
  licenses      License[]
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  code    String   @unique // used in asset tag e.g. NP-LAP-0001
  assets  Asset[]
  tickets Ticket[]
}

model Asset {
  id                   Int            @id @default(autoincrement())
  assetTag             String         @unique
  serialNumber         String         @unique
  model                String
  manufacturer         String
  categoryId           Int
  category             Category       @relation(fields: [categoryId], references: [id])
  vendorId             Int?
  vendor               Vendor?        @relation(fields: [vendorId], references: [id])
  purchaseDate         DateTime?
  purchasePrice        Decimal?       @db.Decimal(12, 2)
  invoiceFile          String?
  warrantyStart        DateTime?
  warrantyEnd          DateTime?
  warrantyFile         String?
  locationId           Int?
  location             Location?      @relation(fields: [locationId], references: [id])
  departmentId         Int?
  department           Department?    @relation(fields: [departmentId], references: [id])
  status               AssetStatus    @default(AVAILABLE)
  assignedToId         Int?
  assignedTo           User?          @relation("AssetAssignee", fields: [assignedToId], references: [id])
  notes                String?
  ram                  String?
  storage              String?
  cpu                  String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  assignments          Assignment[]
  repairTickets        RepairTicket[]

  // Expanded CMDB fields
  gst                  Decimal?       @db.Decimal(12, 2)
  insuranceDetails     String?
  insuranceExpiry      DateTime?
  floor                String?
  cabin                String?
  rackNumber           String?
  costCentre           String?
  ownerDepartment      String?
  nextMaintenance      DateTime?
  lastMaintenance      DateTime?
  scrapDate            DateTime?
  disposalMethod       String?

  // Laptops/Desktops specific configurations
  gpu                  String?
  gpuMemory            String?
  windowsEdition       String?
  windowsVersion       String?
  buildNumber          String?
  activationStatus     String?
  computerName         String?
  domainName           String?
  wifiMac              String?
  bluetoothMac         String?
  bitLockerStatus      String?
  tpmVersion           String?
  secureBootStatus     String?
  defenderStatus       String?
  esetStatus           String?
  firewallStatus       String?
  recoveryKey          String?

  // Printer specific
  drumModel            String?
  currentPageCount     Int?           @default(0)

  // Mobile specific
  imeiNumber2          String?
  carrier              String?
  mdmStatus            String?

  // Network specific
  wanIp                String?
  portsCount           Int?
  ispName              String?
  firmwareVersion      String?

  // ITSM relations
  linkedTickets        Ticket[]       @relation("AssetTickets")
  maintenances         Maintenance[]

  @@index([status])
  @@index([categoryId])
  @@index([warrantyEnd])
}

model Maintenance {
  id              Int       @id @default(autoincrement())
  assetId         Int
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceDate DateTime
  notes           String?
  performedBy     String?
  cost            Decimal   @default(0) @db.Decimal(12, 2)
  nextDueDate     DateTime?
  status          String    @default("COMPLETED") // COMPLETED, SCHEDULED
  createdAt       DateTime  @default(now())
}

model Assignment {
  id            Int              @id @default(autoincrement())
  assetId       Int
  asset         Asset            @relation(fields: [assetId], references: [id])
  userId        Int
  user          User             @relation("AssignmentUser", fields: [userId], references: [id])
  action        AssignmentAction
  performedById Int
  performedBy   User             @relation("AssignmentActor", fields: [performedById], references: [id])
  notes         String?
  signature     String? // base64 PNG of employee digital signature
  ackFile       String? // generated acknowledgement PDF path
  createdAt     DateTime         @default(now())
  returnedAt    DateTime?

  @@index([assetId])
  @@index([userId])
}

model RepairTicket {
  id              Int          @id @default(autoincrement())
  ticketNo        String       @unique
  assetId         Int
  asset           Asset        @relation(fields: [assetId], references: [id])
  reportedById    Int
  reportedBy      User         @relation(fields: [reportedById], references: [id])
  vendorId        Int?
  vendor          Vendor?      @relation(fields: [vendorId], references: [id])
  issue           String
  diagnosis       String?
  partsReplaced   String?
  isWarrantyClaim Boolean      @default(false)
  cost            Decimal      @default(0) @db.Decimal(12, 2)
  status          RepairStatus @default(OPEN)
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  updatedAt       DateTime     @updatedAt

  @@index([status])
}

model License {
  id           Int                 @id @default(autoincrement())
  name         String // e.g. Microsoft 365 Business Premium
  type         String // M365 | ANTIVIRUS | RINGCENTRAL | DYNAMICS365 | OTHER
  vendorId     Int?
  vendor       Vendor?             @relation(fields: [vendorId], references: [id])
  licenseKey   String?
  totalSeats   Int                 @default(1)
  purchaseDate DateTime?
  expiryDate   DateTime?
  costPerSeat  Decimal?            @db.Decimal(12, 2)
  totalCost    Decimal?            @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  assignments  LicenseAssignment[]

  @@index([expiryDate])
}

model LicenseAssignment {
  id         Int       @id @default(autoincrement())
  licenseId  Int
  license    License   @relation(fields: [licenseId], references: [id])
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([licenseId])
  @@index([userId])
}

model StockItem {
  id          Int       @id @default(autoincrement())
  name        String
  type        StockType
  quantity    Int       @default(0)
  minQuantity Int       @default(5)
  unitPrice   Decimal?  @db.Decimal(12, 2)
  locationId  Int?
  location    Location? @relation(fields: [locationId], references: [id])
  notes       String?
  updatedAt   DateTime  @updatedAt

  @@unique([name, locationId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE | UPDATE | DELETE | ASSIGN | RETURN | LOGIN | ...
  entity    String // Asset | User | Assignment | ...
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ==========================================
// ITSM MODELS
// ==========================================

model Ticket {
  id                  Int                @id @default(autoincrement())
  ticketNo            String             @unique // INC-000001, SR-000001, CHG-000001
  type                TicketType
  summary             String
  description         String
  priority            TicketPriority     @default(MEDIUM)
  status              TicketStatus       @default(NEW)
  
  requesterId         Int
  requester           User               @relation("TicketRequester", fields: [requesterId], references: [id])
  
  affectedUserId      Int?
  affectedUser        User?              @relation("TicketAffectedUser", fields: [affectedUserId], references: [id])
  
  departmentId        Int?
  locationId          Int?
  
  categoryId          Int?
  category            Category?          @relation(fields: [categoryId], references: [id])
  
  assignedToId        Int?
  assignedTo          User?              @relation("TicketAssignee", fields: [assignedToId], references: [id])
  
  slaStatus           SLAStatus          @default(WITHIN_SLA)
  slaResponseExpiry   DateTime?
  slaResolutionExpiry DateTime?
  firstResponseAt     DateTime?
  dueAt               DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  
  parentTicketId      Int?
  parentTicket        Ticket?            @relation("ParentChild", fields: [parentTicketId], references: [id])
  childTickets        Ticket[]           @relation("ParentChild")
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  
  comments            TicketComment[]
  attachments         TicketAttachment[]
  watchers            TicketWatcher[]
  workLogs            WorkLog[]
  approvals           Approval[]
  linkedAssets        Asset[]            @relation("AssetTickets")
  surveys             Survey[]
  customValues        CustomFieldValue[]

  @@index([status])
  @@index([type])
  @@index([priority])
}

model TicketComment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model TicketAttachment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  fileSize  Int
  createdAt DateTime @default(now())
}

model TicketWatcher {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
  
  @@unique([ticketId, userId])
}

model WorkLog {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technicianId Int
  technician   User     @relation(fields: [technicianId], references: [id])
  timeSpent    Int      // in minutes
  notes        String?
  createdAt    DateTime @default(now())
}

model SLA {
  id                 Int            @id @default(autoincrement())
  name               String
  priority           TicketPriority
  type               TicketType
  responseTimeMins   Int
  resolutionTimeMins Int
  isActive           Boolean        @default(true)
}

model Approval {
  id        Int            @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title     String
  status    ApprovalStatus @default(PENDING)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  steps     ApprovalStep[]
}

model ApprovalStep {
  id         Int            @id @default(autoincrement())
  approvalId Int
  approval   Approval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approverId Int
  approver   User           @relation(fields: [approverId], references: [id])
  status     ApprovalStatus @default(PENDING)
  comments   String?
  actionedAt DateTime?
}

model AutomationRule {
  id         Int      @id @default(autoincrement())
  name       String
  trigger    String // e.g. "TICKET_CREATED", "STATUS_CHANGED"
  conditions Json // e.g. { "priority": "CRITICAL" }
  actions    Json // e.g. { "assignTo": 5, "status": "ASSIGNED" }
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model KnowledgeArticle {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  category   String // e.g. "VPN", "Hardware"
  status     String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])
  helpful    Int      @default(0)
  notHelpful Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Survey {
  id                 Int      @id @default(autoincrement())
  ticketId           Int
  ticket             Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  rating             Int      // 1 to 5
  resolutionQuality  Int      // 1 to 5
  technicianBehavior Int      // 1 to 5
  responseTimeRating Int      // 1 to 5
  comments           String?
  createdAt          DateTime @default(now())
}

model OnboardingRequest {
  id               Int      @id @default(autoincrement())
  employeeName     String
  personalEmail    String
  companyEmail     String?
  jobTitle         String
  departmentId     Int
  reportingManager String
  joiningDate      DateTime
  officeLocation   String
  assetsNeeded     Json // list of asset types requested
  status           String   @default("PENDING") // PENDING, COMPLETED
  createdAt        DateTime @default(now())
}

model OffboardingRequest {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  lastWorkingDate DateTime
  disableAccount  Boolean  @default(true)
  returnAssets    Boolean  @default(true)
  status          String   @default("PENDING") // PENDING, COMPLETED
  createdAt       DateTime @default(now())
}

model CustomField {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  fieldType String // "TEXT" | "NUMBER" | "SELECT"
  options   String? // JSON array of options if SELECT
  values    CustomFieldValue[]
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  customFieldId Int
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  ticketId      Int
  ticket        Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  value         String
}

model PurchaseRequest {
  id            Int      @id @default(autoincrement())
  title         String
  costCenter    String
  estimatedCost Decimal  @db.Decimal(12, 2)
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedBy   String?
  createdAt     DateTime @default(now())
}

model PurchaseOrder {
  id            Int      @id @default(autoincrement())
  poNumber      String   @unique
  vendorName    String
  totalAmount   Decimal  @db.Decimal(12, 2)
  status        String   @default("DRAFT") // APPROVED, RECEIVED, COMPLETED
  costCenter    String
  createdAt     DateTime @default(now())
}
